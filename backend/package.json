{
  "name": "buildbridge-backend",
  "version": "1.0.0",
  "description": "Backend API for BuildBridge AI & AR marketplace platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "npm run build && node dist/seed.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"No linting configured\"",
    "test": "npm run build && node --test dist/auth.test.js dist/routes.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "multer": "^2.2.0",
    "prisma": "^5.14.0",
    "redis": "^4.6.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.12",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
