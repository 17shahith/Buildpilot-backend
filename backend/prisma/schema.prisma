generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum PropertyType {
  BUY
  RENT
}

enum BookingStatus {
  PENDING
  APPROVED
  CANCELLED
}

model User {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  email              String           @unique
  password           String
  role               Role
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  profile            Profile?
  bookings           Booking[]
  quotes             Quote[]
  applications       ProApplication[]
  clientProjects     Project[]        @relation("ClientProjects")
  contractorProjects Project[]        @relation("ContractorProjects")
  tasks              Task[]
  documents          Document[]
  notifications      Notification[]
  auditLogs          AuditLog[]
}

model Profile {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  userId      String    @unique @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleTitle   String?
  location    String?
  hourlyRate  Float?
  bio         String?
  rating      Float     @default(0.0)
  reviewsCount Int      @default(0)
  verified    Boolean   @default(false)
  tags        String[]
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model Property {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  price     Float
  type      PropertyType
  rooms     String
  location  String
  imageUrl  String
  verified  Boolean      @default(false)
  tags      String[]
  createdAt DateTime     @default(now())

  @@index([type, price])
  @@index([location])
}

model Booking {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  clientId  String        @db.ObjectId
  client    User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profileId String        @db.ObjectId
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Restrict)
  date      DateTime
  status    BookingStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())

  @@index([clientId])
  @@index([profileId, date])
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  client    String
  details   String
  budget    Float
  date      String
  urgency   String
  createdAt DateTime @default(now())
}

model Quote {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  professionalId String   @db.ObjectId
  professional   User     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  clientName     String
  materialCost   Float
  laborCost      Float
  totalCost      Float
  remarks        String?
  createdAt      DateTime @default(now())

  @@index([professionalId])
}

model ProApplication {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      String
  license   String
  date      String
  status    String   @default("Pending")
  createdAt DateTime @default(now())
}

model FlaggedPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  title     String
  reason    String
  date      String
  createdAt DateTime @default(now())
}

model Project {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  status       String      @default("PLANNING")
  budget       Float
  clientId     String      @db.ObjectId
  client       User        @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  contractorId String?     @db.ObjectId
  contractor   User?       @relation("ContractorProjects", fields: [contractorId], references: [id], onDelete: SetNull)
  milestones   Milestone[]
  expenses     Expense[]
  payments     Payment[]
  documents    Document[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([clientId])
  @@index([contractorId])
}

model Milestone {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  status    String   @default("PENDING")
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Task {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  status      String    @default("PENDING")
  milestoneId String    @db.ObjectId
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assigneeId  String?   @db.ObjectId
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([milestoneId])
  @@index([assigneeId])
}

model Expense {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Float
  category  String
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Payment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Float
  status    String   @default("PENDING")
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Document {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  url       String
  type      String
  projectId String?  @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ownerId   String   @db.ObjectId
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([ownerId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  message   String
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  result     String
  timestamp  DateTime @default(now())
  ip         String?
  metadata   String?
}

model SecurityPolicy {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  role      String
  resource  String
  action    String
  rule      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, resource, action])
}

model VectorDocument {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  projectId String?         @db.ObjectId
  chunks    DocumentChunk[]
  createdAt DateTime        @default(now())

  @@index([projectId])
}

model DocumentChunk {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  vectorDocumentId String         @db.ObjectId
  document         VectorDocument @relation(fields: [vectorDocumentId], references: [id], onDelete: Cascade)
  content          String
  embedding        Float[]
  createdAt        DateTime       @default(now())

  @@index([vectorDocumentId])
}
