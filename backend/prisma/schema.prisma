generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum PropertyType {
  BUY
  RENT
}

enum BookingStatus {
  PENDING
  APPROVED
  CANCELLED
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique
  password  String
  role      Role
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile      Profile?
  bookings     Booking[]
  quotes       Quote[]
  applications ProApplication[]
}

model Profile {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  userId      String    @unique @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleTitle   String?
  location    String?
  hourlyRate  Float?
  bio         String?
  rating      Float     @default(0.0)
  reviewsCount Int      @default(0)
  verified    Boolean   @default(false)
  tags        String[]
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model Property {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  price     Float
  type      PropertyType
  rooms     String
  location  String
  imageUrl  String
  verified  Boolean      @default(false)
  tags      String[]
  createdAt DateTime     @default(now())

  @@index([type, price])
  @@index([location])
}

model Booking {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  clientId  String        @db.ObjectId
  client    User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profileId String        @db.ObjectId
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Restrict)
  date      DateTime
  status    BookingStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())

  @@index([clientId])
  @@index([profileId, date])
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  client    String
  details   String
  budget    Float
  date      String
  urgency   String
  createdAt DateTime @default(now())
}

model Quote {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  professionalId String   @db.ObjectId
  professional   User     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  clientName     String
  materialCost   Float
  laborCost      Float
  totalCost      Float
  remarks        String?
  createdAt      DateTime @default(now())

  @@index([professionalId])
}

model ProApplication {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      String
  license   String
  date      String
  status    String   @default("Pending")
  createdAt DateTime @default(now())
}

model FlaggedPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  title     String
  reason    String
  date      String
  createdAt DateTime @default(now())
}
